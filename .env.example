# Database Configuration
# Local SQLite default (Zero-setup local development):
DATABASE_URL="file:./dev.db"

# Cloud Neon PostgreSQL free tier (Production deployment):
# DATABASE_URL="postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require"

# Webhook Authentication (Optional shared secret with zechack indexer)
ZECHACK_WEBHOOK_SECRET="optional_shared_hmac_secret_key"

# Cloudinary (Optional free tier image hosting - max 2MB enforced client-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
